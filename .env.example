# =============================================================
# Fleet Logbook & Monitoring System — Template Konfigurasi
# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK boleh masuk Git.
# =============================================================

# --- Aplikasi ---
APP_NAME="Fleet Logbook"
APP_ENV=local
APP_URL=http://localhost
APP_DEBUG=true

# --- Waktu ---
# Semua timestamp perjalanan ditulis server dalam zona ini.
APP_TIMEZONE=Asia/Jakarta

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kendaraan_logbook
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Session (menit) ---
SESSION_IDLE_TIMEOUT=30
SESSION_ABSOLUTE_TIMEOUT=720

# --- Login throttle ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- GPS & destinasi ---
DESTINATION_RADIUS_DEFAULT_M=100
GPS_MAX_ACCURACY_M=100
GPS_TIMEOUT_SECONDS=15

# --- Upload ---
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp
ALLOWED_DOC_MIME=application/pdf,image/jpeg,image/png,image/webp

# --- OCR ---
OCR_ENABLED=true
OCR_LANGUAGES=ind+eng

# --- Watermark evidence (preview) ---
WATERMARK_ENABLED=true

# --- Reverse geocoding (server-side + cache) ---
GEOCODE_PROVIDER=nominatim
GEOCODE_USER_AGENT="FleetLogbook/1.0 (internal-hospital-app)"
GEOCODE_CACHE_DAYS=180
